   "text_blocks": [
    {
     "snippet": "The time complexity of a binary search algorithm is $O(\\log n)$, and O(1) in the best case.",
     "snippet_highlighted_words": [
      "O(1) in the best case"
     ],
     "snippet_latex": [
      "O(\\log n)"
     ],
     "type": "paragraph"
    },
    {
     "snippet": "Here is a quick breakdown of how it performs depending on the scenario:",
     "type": "paragraph"
    },
